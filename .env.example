# LLM Provider Configuration (vertex | openai_compat)
LLM_PROVIDER=vertex
LLM_MODEL=gemini-2.5-flash

# Google Cloud Vertex AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# OpenAI-Compatible Configuration (Optional alternative)
# LLM_PROVIDER=openai_compat
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=your_openai_api_key_here

# Usage log for the Streamlit app (the CLI writes <out>/usage.jsonl per run)
USAGE_LOG_PATH=outputs/usage.jsonl

# Prices used for the cost estimate (USD per 1M tokens). Defaults: gemini-2.5-flash on Vertex AI.
# LLM_PRICE_INPUT_PER_M=0.30
# LLM_PRICE_OUTPUT_PER_M=2.50
